  <section xml:id="Math2301HW4">
    <title>Normies</title>

    <subsection xml:id="sec-normal-things">
      <title>Normal Things</title>

      <exercise xml:id="ex-norm-scalar">
        <statement>
          <p>Let <m>V</m> be an inner product space. Show that for all
          <m>\vec{v}\in V</m> and <m>c\in\mathbb{R}</m>,
          <me>\|c\vec{v}\|=|c|\|\vec{v}\|.</me></p>
        </statement>
      </exercise>

      <p>A function <m>f:V\to\mathbb{R}</m> is <term>convex</term> if, for any
      <m>t\in[0,1]</m> and <m>\vec{x},\vec{y}\in V</m>,
      <m>f(t\vec{x}+(1-t)\vec{y})\leq t f(\vec{x})+(1-t)f(\vec{y})</m>.</p>

      <exercise xml:id="ex-norm-convex">
        <statement>
          <p>Let <m>V</m> be an inner product space. Show that
          <m>f:V\to\mathbb{R}</m> defined by
          <m>f(\vec{x})=\|\vec{x}\|</m> is a convex function.</p>
        </statement>
      </exercise>
    </subsection>

    <subsection xml:id="sec-quadratic-algebra">
      <title>Quadratic Algebra</title>

      <p>Let <m>A</m> be an invertible <m>n\times n</m> matrix.
      Define <m>\langle\cdot,\cdot\rangle_A:\mathbb{R}^n\times\mathbb{R}^n\to\mathbb{R}</m>
      by <m>\langle\vec{x},\vec{y}\rangle_A=A\vec{x}\cdot A\vec{y}</m>.</p>

      <exercise xml:id="ex-quadratic-form">
        <statement>
          <p>Show that
          <m>\langle\vec{x},\vec{y}\rangle_A=\vec{x}^{\intercal}A^{\intercal}A\vec{y}</m>,
          where we interpret <m>\vec{x}^{\intercal}</m> as a
          <m>1\times n</m> matrix.</p>
        </statement>
      </exercise>

      <exercise xml:id="ex-induced-inner-product">
        <statement>
          <p>Show that <m>\langle\cdot,\cdot\rangle_A</m> is an inner
          product on <m>\mathbb{R}^n</m>.</p>
        </statement>
      </exercise>
    </subsection>

    <subsection xml:id="sec-geometry">
      <title>Geometry</title>

      <p>Let <m>\vec{c}\in\mathbb{R}^n</m>, and suppose that
      <m>\|\vec{c}\|=1</m>. Define the hyperplane
      <m>H_{\vec{c}}=\{\vec{x}:\langle\vec{c},\vec{x}\rangle=0\}</m>,
      the set of vectors orthogonal to <m>\vec{c}</m>.</p>

      <exercise xml:id="ex-distance-lower-bound">
        <statement>
          <p>Show that for any <m>\vec{x}\in H_{\vec{c}}</m> and
          <m>\vec{y}\notin H_{\vec{c}}</m>,
          <me>\|\vec{x}-\vec{y}\|\geq|\langle\vec{c},\vec{y}\rangle|.</me></p>
        </statement>
      </exercise>

      <exercise xml:id="ex-projection-attains-bound">
        <statement>
          <p>Let <m>\vec{y}\notin H_{\vec{c}}</m>. Define
          <me>\vec{x}=\vec{y}-\langle\vec{c},\vec{y}\rangle\vec{c}.</me></p>
          <ol>
            <li><p>Show that <m>\vec{x}\in H_{\vec{c}}</m>.</p></li>
            <li><p>Show that
            <m>\|\vec{x}-\vec{y}\|=|\langle\vec{c},\vec{y}\rangle|</m>.</p></li>
            <li><p>What does combining the results of
            <xref ref="ex-distance-lower-bound"/> and this exercise tell you?</p></li>
          </ol>
        </statement>
      </exercise>
    </subsection>
  </section>

