      % \[\begin{pmatrix} 1 & 0 & 0 \\ 0 & 1 & 0\end{pmatrix}\begin{pmatrix} x \\ y \\ z \end{pmatrix} = \begin{pmatrix} 0 \\ 0 \end{pmatrix}\]

      % \begin{itemize}
      %     \item What is the rank of the matrix?
      %     \item What is the nullity of the matrix? 
      %     \item What is the rank plus the nullity? 
      %     \item Are the rows of this matrix spanning?
